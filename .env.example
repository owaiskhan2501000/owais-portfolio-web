# Optional — enables the contact form (free key from https://web3forms.com).
# If empty, the form falls back to opening the visitor's email client.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Public URL of the deployed site (used for SEO metadata, sitemap and OG images)
NEXT_PUBLIC_SITE_URL=https://owais-portfolio-web.vercel.app
